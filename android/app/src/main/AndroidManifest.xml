<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 打电话 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- 发短信 -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 读取/写入通讯录 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- 生物认证（指纹） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 访问通讯录后端服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 来电显示名片：响铃状态 + 号码（Android 10+ 需 READ_CALL_LOG 才能拿到号码） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Android 13+ 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 全屏意图通知（来电名片顶到系统来电界面；Android 14+ 需用户在系统设置里放行） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 亮屏弹出兜底：系统仅在锁屏/息屏时应用全屏意图，拿到「显示在其他应用上层」
         后可直接拉起名片页，亮屏使用中也能弹出（用户手动授权，仅作兜底） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 扫码激活：扫描管理员发放的激活码二维码（相机非必需，无摄像头设备也能用） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 前台服务保活：让进程在用户划掉后台后仍尽量存活，保证来电广播及时送达 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <application
        android:label="通讯录"
        android:name=".PhonebookApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"><!-- 开发期允许 http 访问后端；上线改 https 后请移除 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 全屏来电名片（fullScreenIntent 拉起；锁屏可整屏显示） -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/IncomingCallTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode|locale" />

        <!-- 来电监听（进程未运行也能收到响铃广播） -->
        <receiver
            android:name=".CallerIdReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- 来电筛选：响铃瞬间拿到来电号码（比通话记录早数秒）。
             需用户在系统里授予「来电筛选」角色；只做展示，绝不拦截电话。 -->
        <service
            android:name=".CallerIdScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- 来电名片常驻前台服务（保活，可在设置里关闭） -->
        <service
            android:name=".CallerIdService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="caller_id_detection" />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
