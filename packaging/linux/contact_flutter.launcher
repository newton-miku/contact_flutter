#!/bin/sh
# contact_flutter 启动包装脚本（随 deb 安装到 /opt/contact_flutter/contact_flutter）
#
# 为什么要包一层：
#   1. Flutter 桌面版的 .so 放在 bundle 的 lib/ 下，用 $ORIGIN 相对路径加载；
#      从桌面图标启动时工作目录不确定，这里显式补 LD_LIBRARY_PATH 更稳。
#   2. 把 GL 后端钉到「Wayland + GLES」，见下面的 GDK_BACKEND / GDK_GL。
#   3. 把命令行参数原样透传给应用。

BUNDLE_DIR="/opt/contact_flutter"
BIN="$BUNDLE_DIR/contact_flutter.bin"

if [ ! -x "$BIN" ]; then
  echo "contact_flutter: 未找到可执行文件 $BIN（安装可能不完整）" >&2
  exit 1
fi

LD_LIBRARY_PATH="$BUNDLE_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

# 厂商 GL 栈（实测：UOS aarch64 + 海思 libGFX_hisi）通常只实现 GLES，而 GTK 在这类
# 系统上默认会走 X11 + 桌面版 OpenGL。这样拿到的上下文里 glGetString(GL_VERSION)
# 返回 NULL，Flutter 引擎随即 abort：
#   [FATAL:flutter/shell/gpu/gpu_surface_gl_delegate.cc(57)] Check failed: gl_version_string.
# 实测这台机器上只有「Wayland 后端 + GLES」能起来，两者缺一不可：
#   GDK_GL=gles           → 仍然 abort
#   GDK_BACKEND=wayland   → 单用没试，但 GLES 是必要条件
#   GDK_BACKEND=wayland GDK_GL=gles → 可用
# 只在真有 Wayland 会话时才钉住；纯 X11 机器保持 GTK 默认，避免误伤正常显卡。
# 想覆盖就自己 export GDK_BACKEND / GDK_GL。
if [ -n "$WAYLAND_DISPLAY" ]; then
  : "${GDK_BACKEND:=wayland}"
  : "${GDK_GL:=gles}"
  export GDK_BACKEND GDK_GL
fi

exec "$BIN" "$@"
