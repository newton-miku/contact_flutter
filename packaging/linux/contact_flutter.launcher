#!/bin/sh
# contact_flutter 启动包装脚本（随 deb 安装到 /opt/contact_flutter/contact_flutter）
#
# 为什么要包一层：
#   1. Flutter 桌面版的 .so 放在 bundle 的 lib/ 下，用 $ORIGIN 相对路径加载；
#      从桌面图标启动时工作目录不确定，这里显式补 LD_LIBRARY_PATH 更稳。
#   2. 强制 GTK 去要 GLES 上下文，见下面的 GDK_GL。
#   3. 把命令行参数原样透传给应用。

BUNDLE_DIR="/opt/contact_flutter"
BIN="$BUNDLE_DIR/contact_flutter.bin"

if [ ! -x "$BIN" ]; then
  echo "contact_flutter: 未找到可执行文件 $BIN（安装可能不完整）" >&2
  exit 1
fi

LD_LIBRARY_PATH="$BUNDLE_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

# 国产 GL 栈（实测：UOS aarch64 + 海思 libGFX_hisi）通常只实现 GLES，而 GTK 默认
# 会去要一份「桌面版 OpenGL」上下文。拿到的上下文不可用，glGetString(GL_VERSION)
# 返回 NULL，Flutter 引擎随即 abort：
#   [FATAL:flutter/shell/gpu/gpu_surface_gl_delegate.cc(57)] Check failed: gl_version_string.
# 逼 GTK 要 GLES 上下文即可绕过。想用 GTK 默认行为就自己 export GDK_GL=gl。
: "${GDK_GL:=gles}"
export GDK_GL

exec "$BIN" "$@"
